<Application x:Class="QuickStart.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:QuickStart.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <infra:IconPlaceholderVisibilityConverter x:Key="IconPlaceholderVisibility" />
      <infra:InitialsConverter x:Key="Initials" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
