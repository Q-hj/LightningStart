<Window x:Class="QuickStart.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickStart · 快捷启动"
        Width="980"
        Height="740"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F5F6FA" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF1FF" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9D3FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="20,18,20,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="368" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: entry list -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="程序列表" FontSize="16" FontWeight="SemiBold" />
            <Border Background="#E9ECF5" CornerRadius="8" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Entries.Count}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Text="拖入 exe / 快捷方式即可添加"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
          <Grid>
            <ListBox x:Name="EntryList"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     PreviewKeyDown="EntryList_PreviewKeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                      <Border Background="#F2F4F9" CornerRadius="7" />
                      <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                 FontSize="13"
                                 Foreground="#8A90A0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
                      <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      <Ellipse Width="7"
                               Height="7"
                               Fill="{StaticResource DangerBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-1,-1,0"
                               ToolTip="目标路径不存在"
                               Visibility="{Binding IsTargetMissing, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12.5"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Target}"
                                 FontSize="10.5"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#F0F2F8"
                            CornerRadius="5"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="管理员" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="把程序拖到这里，或点击下方“添加程序”"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="＋ 添加程序" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
          <Button Content="上移" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}" Margin="8,0,0,0" />
          <Button Content="下移" Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}" Margin="6,0,0,0" />
          <Button Content="移除" Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}" Margin="6,0,0,0" />
        </StackPanel>
      </Grid>

      <!-- Right: detail + behavior -->
      <ScrollViewer Grid.Column="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,6,0">
        <StackPanel>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" IsEnabled="{Binding HasSelection}">
            <StackPanel>
              <Grid>
                <TextBlock Text="选中程序" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="打开位置"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding OpenTargetFolderCommand}"
                          Margin="0,0,8,0" />
                  <Button Content="测试启动"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding TestLaunchCommand}" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top">
                  <Border Background="#F2F4F9" CornerRadius="9" />
                  <TextBlock Text="{Binding SelectedEntry.Name, Converter={StaticResource Initials}}"
                             FontSize="18"
                             Foreground="#8A90A0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="{Binding SelectedEntry.Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
                  <Image Source="{Binding SelectedEntry.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,2,0,0">
                  <TextBlock Text="{Binding SelectedEntry.Name}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SelectedEntry.Target}"
                             FontSize="11.5"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,3,0,0" />
                  <TextBlock Text="⚠ 目标路径不存在"
                             FontSize="11"
                             Foreground="{StaticResource DangerBrush}"
                             Margin="0,3,0,0"
                             Visibility="{Binding SelectedEntry.IsTargetMissing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,16,0,0">
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding SelectedEntry.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="目标路径" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding SelectedEntry.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="2"
                          Content="浏览…"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding BrowseTargetCommand}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="启动参数" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding SelectedEntry.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="快捷方式（.lnk）的参数可能被系统忽略，需要传参时建议直接指向 exe。"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="76,0,0,10" />

                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="工作目录" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding SelectedEntry.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="2"
                          Content="浏览…"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding BrowseWorkingDirectoryCommand}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="自定义图标" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding SelectedEntry.IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="留空则使用目标程序的图标" />
                  <Button Grid.Column="2"
                          Content="浏览…"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding BrowseIconCommand}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center" />
                </Grid>

                <CheckBox Content="以管理员身份运行（每次启动会弹出 UAC 确认）"
                          IsChecked="{Binding SelectedEntry.RunAsAdmin, Mode=TwoWay}"
                          Margin="0,10,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="外观与行为" FontSize="15" FontWeight="SemiBold" />

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="触发方式" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1">
                  <RadioButton x:Name="HoverRadio"
                               Content="悬浮打开"
                               Tag="Hover"
                               GroupName="Trigger"
                               Style="{StaticResource PillRadio}"
                               Checked="TriggerRadio_Checked"
                               Margin="0,0,6,6" />
                  <RadioButton x:Name="ClickRadio"
                               Content="单击打开"
                               Tag="Click"
                               GroupName="Trigger"
                               Style="{StaticResource PillRadio}"
                               Checked="TriggerRadio_Checked"
                               Margin="0,0,6,6" />
                </WrapPanel>
              </Grid>

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="面板列数" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1">
                  <RadioButton x:Name="Cols3" Content="3 列" Tag="3" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="Cols4" Content="4 列" Tag="4" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="Cols5" Content="5 列" Tag="5" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="Cols6" Content="6 列" Tag="6" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                </WrapPanel>
              </Grid>

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="图标大小" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1">
                  <RadioButton x:Name="IconSize32" Content="32" Tag="32" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="IconSize40" Content="40" Tag="40" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="IconSize48" Content="48" Tag="48" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                  <RadioButton x:Name="IconSize64" Content="64" Tag="64" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                </WrapPanel>
              </Grid>

              <CheckBox Content="在图标下方显示程序名称"
                        IsChecked="{Binding Behavior.ShowLabels, Mode=TwoWay}"
                        Margin="0,10,0,0" />
              <CheckBox Content="开机自动启动（登录后最小化到托盘）"
                        IsChecked="{Binding Behavior.StartWithWindows, Mode=TwoWay}"
                        Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="其他" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="配置保存在 %AppData%\QuickStart\config.json，所有修改即时生效。"
                         FontSize="11.5"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0" />
              <WrapPanel Margin="0,12,0,0">
                <Button Content="打开配置目录"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenConfigFolderCommand}"
                        Margin="0,0,8,8" />
                <Button Content="退出 QuickStart"
                        Style="{StaticResource SecondaryButton}"
                        Click="ExitButton_Click"
                        Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="QuickStart 0.1.0"
                         FontSize="10.5"
                         Foreground="{StaticResource MutedTextBrush}"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="1"
               Text="{Binding StatusText}"
               FontSize="11.5"
               Margin="22,0,22,12">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Border Grid.RowSpan="2"
            Margin="10"
            Background="#D94F6BED"
            CornerRadius="14"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            x:Name="DropOverlay">
      <Border Background="#F9FAFF"
              CornerRadius="12"
              Margin="60"
              BorderBrush="#B9C5FF"
              BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="＋"
                     FontSize="44"
                     FontWeight="Light"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="松开以添加到快捷启动"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
