<Window x:Class="QuickStart.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闪电启动"
        Width="980"
        Height="680"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F5F6FA" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EAF2FF" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="12,0"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F4F6FA" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="RowDeleteIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="204" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0"
            Background="#FFFFFF"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="12,18,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,22">
          <Border Width="32" Height="32" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1D4ED8" Offset="0" />
                <GradientStop Color="#3B82F6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Viewbox Margin="7" Stretch="Uniform">
              <Path Data="M 57,8 L 28,55 L 46,55 L 38,92 L 72,42 L 52,42 Z" Fill="#FFFFFF" />
            </Viewbox>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="闪电启动" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="快捷启动器" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="菜单" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,6" />

        <StackPanel Grid.Row="2">
          <RadioButton x:Name="NavApps"
                       GroupName="Nav"
                       Style="{StaticResource NavItem}"
                       IsChecked="True"
                       AutomationProperties.Name="应用列表"
                       Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="应用列表" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="NavSettings"
                       GroupName="Nav"
                       Style="{StaticResource NavItem}"
                       AutomationProperties.Name="系统设置"
                       Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="系统设置" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Border Height="1" Background="#EEF0F5" Margin="0,0,0,10" />
          <TextBlock Text="{Binding VersionText}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="24,20,24,6">

        <!-- Page 1: application list -->
        <Grid x:Name="AppListPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="应用列表" FontSize="20" FontWeight="SemiBold" />
                <Border Background="#E9ECF5" CornerRadius="8" Padding="7,0" Margin="9,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Entries.Count}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
              </StackPanel>
              <Border Background="{StaticResource AccentSoftBrush}"
                      CornerRadius="7"
                      Padding="10,4"
                      HorizontalAlignment="Left"
                      Margin="0,7,0,0">
                <TextBlock Text="可通过拖动应用程序以添加"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
              </Border>
            </StackPanel>
            <Button Content="＋ 添加程序"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="336" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: entry list -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                  <ListBox x:Name="EntryList"
                           ItemsSource="{Binding Entries}"
                           SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                           AllowDrop="True"
                           PreviewKeyDown="EntryList_PreviewKeyDown"
                           PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                           PreviewMouseMove="EntryList_PreviewMouseMove"
                           DragOver="EntryList_DragOver"
                           DragLeave="EntryList_DragLeave"
                           Drop="EntryList_Drop">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Grid.Style>
                              <Style TargetType="Grid">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Hidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Grid.Style>
                            <Border Background="#F2F4F9" CornerRadius="7" />
                            <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                       FontSize="13"
                                       Foreground="#8A90A0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource DangerBrush}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-1,-1,0"
                                     ToolTip="目标路径不存在"
                                     Visibility="{Binding IsTargetMissing, Converter={StaticResource BoolToVisibility}}" />
                          </Grid>

                          <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Hidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Target}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F0F2F8"
                                    CornerRadius="5"
                                    Padding="5,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="管理员" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>

                            <Border Background="#F0F2F8"
                                    CornerRadius="5"
                                    Padding="5,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Hidden, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="已隐藏" FontSize="9.5" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>

                            <Button Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    AutomationProperties.Name="隐藏或显示">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowIconButton}">
                                  <Setter Property="Content" Value="&#xE890;" />
                                  <Setter Property="ToolTip" Value="在托盘面板中隐藏" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                                      <Setter Property="Content" Value="&#xED1A;" />
                                      <Setter Property="ToolTip" Value="在托盘面板中显示" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>

                            <Button Content="&#xE74D;"
                                    Style="{StaticResource RowDeleteIconButton}"
                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    AutomationProperties.Name="删除"
                                    ToolTip="从列表中删除"
                                    Margin="2,0,0,0" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <TextBlock Text="点击右上角“添加程序”，或把文件拖到这里"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="12"
                             Margin="24"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <Border x:Name="DropIndicator"
                          Height="3"
                          Margin="4,0,4,0"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentBrush}"
                          CornerRadius="1.5"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.35" Color="#2563EB" />
                    </Border.Effect>
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="上移" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}" />
                  <Button Content="下移" Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}" Margin="6,0,0,0" />
                  <Button Content="移除" Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="拖动条目可排序 · Delete 删除"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}" />
              </Grid>
            </Grid>

            <!-- Right: entry detail -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
              <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding HasSelection}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="程序详情" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="打开位置"
                              Style="{StaticResource SecondaryButton}"
                              Command="{Binding OpenTargetFolderCommand}"
                              Margin="0,0,8,0" />
                      <Button Content="测试启动"
                              Style="{StaticResource SecondaryButton}"
                              Command="{Binding TestLaunchCommand}" />
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top">
                      <Border Background="#F2F4F9" CornerRadius="9" />
                      <TextBlock Text="{Binding SelectedEntry.Name, Converter={StaticResource Initials}}"
                                 FontSize="18"
                                 Foreground="#8A90A0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding SelectedEntry.Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
                      <Image Source="{Binding SelectedEntry.Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,2,0,0">
                      <TextBlock Text="{Binding SelectedEntry.Name}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SelectedEntry.Target}"
                                 FontSize="11.5"
                                 Foreground="{StaticResource SecondaryTextBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,3,0,0" />
                      <TextBlock Text="⚠ 目标路径不存在"
                                 FontSize="11"
                                 Foreground="{StaticResource DangerBrush}"
                                 Margin="0,3,0,0"
                                 Visibility="{Binding SelectedEntry.IsTargetMissing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Margin="0,18,0,0">
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding SelectedEntry.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="目标路径" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{Binding SelectedEntry.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="2"
                              Content="浏览…"
                              Style="{StaticResource SecondaryButton}"
                              Command="{Binding BrowseTargetCommand}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="启动参数" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding SelectedEntry.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="快捷方式（.lnk）的参数可能被系统忽略，需要传参时建议直接指向 exe。"
                               FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="76,0,0,10" />

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="工作目录" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{Binding SelectedEntry.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="2"
                              Content="浏览…"
                              Style="{StaticResource SecondaryButton}"
                              Command="{Binding BrowseWorkingDirectoryCommand}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="自定义图标" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Text="{Binding SelectedEntry.IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="留空则使用目标程序的图标" />
                      <Button Grid.Column="2"
                              Content="浏览…"
                              Style="{StaticResource SecondaryButton}"
                              Command="{Binding BrowseIconCommand}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="以管理员身份运行（每次启动会弹出 UAC 确认）"
                              IsChecked="{Binding SelectedEntry.RunAsAdmin, Mode=TwoWay}"
                              Margin="0,12,0,0" />

                    <TextBlock Text="修改会实时保存并立即生效。"
                               FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,12,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- Page 2: system settings -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="系统设置" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="调整面板外观、启动行为与其他选项"
                       FontSize="11.5"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,6,0">
            <StackPanel MaxWidth="680" HorizontalAlignment="Stretch">

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="托盘面板的布局与尺寸"
                             FontSize="11.5"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Margin="0,4,0,0" />

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图标大小" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                      <RadioButton x:Name="IconSize24" Content="24" Tag="24" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="IconSize32" Content="32" Tag="32" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="IconSize40" Content="40" Tag="40" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="IconSize48" Content="48" Tag="48" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="IconSize64" Content="64" Tag="64" GroupName="IconSize" Style="{StaticResource PillRadio}" Checked="IconSizeRadio_Checked" Margin="0,0,6,6" />
                    </WrapPanel>
                  </Grid>

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="面板列数" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                      <RadioButton x:Name="Cols3" Content="3 列" Tag="3" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="Cols4" Content="4 列" Tag="4" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="Cols5" Content="5 列" Tag="5" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                      <RadioButton x:Name="Cols6" Content="6 列" Tag="6" GroupName="Columns" Style="{StaticResource PillRadio}" Checked="ColumnsRadio_Checked" Margin="0,0,6,6" />
                    </WrapPanel>
                  </Grid>

                  <CheckBox Content="在图标下方显示程序名称"
                            IsChecked="{Binding Behavior.ShowLabels, Mode=TwoWay}"
                            Margin="0,12,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="行为" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="打开方式与系统集成"
                             FontSize="11.5"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Margin="0,4,0,0" />

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="触发方式" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                      <RadioButton x:Name="HoverRadio"
                                   Content="悬浮打开"
                                   Tag="Hover"
                                   GroupName="Trigger"
                                   Style="{StaticResource PillRadio}"
                                   Checked="TriggerRadio_Checked"
                                   Margin="0,0,6,6" />
                      <RadioButton x:Name="ClickRadio"
                                   Content="单击打开"
                                   Tag="Click"
                                   GroupName="Trigger"
                                   Style="{StaticResource PillRadio}"
                                   Checked="TriggerRadio_Checked"
                                   Margin="0,0,6,6" />
                    </WrapPanel>
                  </Grid>

                  <CheckBox Content="开机自动启动（登录后仅驻留托盘）"
                            IsChecked="{Binding Behavior.StartWithWindows, Mode=TwoWay}"
                            Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="其他" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="配置保存在 %AppData%\LightningStart\config.json，所有修改即时生效。"
                             FontSize="11.5"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0" />
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="打开配置目录"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenConfigFolderCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="退出 闪电启动"
                            Style="{StaticResource SecondaryButton}"
                            Click="ExitButton_Click"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <TextBlock Grid.Row="1"
                 Text="{Binding StatusText}"
                 FontSize="11.5"
                 Margin="26,0,26,12">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Border Grid.ColumnSpan="2"
            Margin="10"
            Background="#D92563EB"
            CornerRadius="14"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            x:Name="DropOverlay">
      <Border Background="#F9FAFF"
              CornerRadius="12"
              Margin="60"
              BorderBrush="#B9C5FF"
              BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="＋"
                     FontSize="44"
                     FontWeight="Light"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="松开以添加到快捷启动"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Border>

    <Canvas x:Name="DragPreviewCanvas"
            Grid.ColumnSpan="2"
            IsHitTestVisible="False"
            Panel.ZIndex="100">
      <Border x:Name="DragGhost"
              Visibility="Collapsed"
              Background="#F2FCFCFE"
              BorderBrush="#D8DCE8"
              BorderThickness="1"
              CornerRadius="8"
              Padding="9,5,11,5">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.2" Color="#000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="20" Height="20">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" />
            <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                       FontSize="11"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
            <Image Source="{Binding Icon}" Stretch="Uniform" />
          </Grid>
          <TextBlock Text="{Binding Name}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     MaxWidth="180"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>
