<Window x:Class="QuickStart.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闪电启动"
        Width="384"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid Margin="12">
    <Border x:Name="Card"
            Background="#FBFBFD"
            BorderBrush="#E4E6EF"
            BorderThickness="1"
            CornerRadius="14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.20" Color="#101322" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#F7F8FC"
                CornerRadius="13,13,0,0"
                Padding="14,10,12,9"
                Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="闪电启动" FontSize="12" FontWeight="SemiBold" Foreground="#6B7180" />
              <Border Background="{StaticResource AccentSoftBrush}"
                      CornerRadius="7"
                      Padding="6,0"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding PanelEntryCount}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
              </Border>
            </StackPanel>
            <Button Content="打开主视图"
                    Style="{StaticResource FlyoutLinkButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OpenMainView_Click" />
          </Grid>
        </Border>

        <!-- Header divider -->
        <Border Grid.Row="1" Height="1" Background="#ECEEF4" />

        <!-- Body -->
        <Grid Grid.Row="2" Margin="12,10,12,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <ScrollViewer MaxHeight="432"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding PanelEntries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Behavior.Columns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource LaunchButton}"
                            Click="Entry_Click"
                            AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{Binding Target}">
                      <StackPanel Margin="0,2" HorizontalAlignment="Center">
                        <Grid Width="{Binding DataContext.Behavior.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Height="{Binding DataContext.Behavior.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <Border Background="#F2F4F9" CornerRadius="8" />
                          <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                     FontSize="12"
                                     Foreground="#8A90A0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding Icon, Converter={StaticResource IconPlaceholderVisibility}}" />
                          <Image Source="{Binding Icon}"
                                 Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality" />
                          <Ellipse Width="8"
                                   Height="8"
                                   Fill="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,-2,-2,0"
                                   Visibility="{Binding IsTargetMissing, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <TextBlock Text="{Binding Name}"
                                   HorizontalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="#4B5163"
                                   Margin="0,5,0,0"
                                   MaxWidth="60"
                                   MaxHeight="28"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="14"
                                   LineStackingStrategy="BlockLineHeight"
                                   Visibility="{Binding DataContext.Behavior.ShowLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20,16">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PanelEntryCount}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="面板还是空的"
                         FontSize="12"
                         Foreground="{StaticResource MutedTextBrush}"
                         HorizontalAlignment="Center" />
              <Button Content="去添加程序"
                      Style="{StaticResource FlyoutLinkButton}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,0"
                      Click="OpenMainView_Click" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="ErrorText"
                     Grid.Row="1"
                     Foreground="{StaticResource DangerBrush}"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     Margin="4,8,4,0"
                     Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
